/* WageWise — Tema Dark (default) */

/* === QMainWindow & QWidget === */
QMainWindow {
    background-color: #1e1e2e;
}
QWidget {
    background-color: #1e1e2e;
    color: #ffffff;
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
}

/* === QPushButton === */
QPushButton {
    background-color: #2a2a3c;
    color: #ffffff;
    border: 1px solid #3a3a4c;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
}
QPushButton:hover {
    background-color: #3a3a4c;
    border-color: #6c63ff;
}
QPushButton:pressed {
    background-color: #6c63ff;
}
QPushButton:disabled {
    background-color: #1a1a2a;
    color: #555566;
    border-color: #2a2a3c;
}
QPushButton:checked {
    background-color: #6c63ff;
    border-color: #6c63ff;
}

/* === QLineEdit === */
QLineEdit {
    background-color: #2a2a3c;
    color: #ffffff;
    border: 1px solid #3a3a4c;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #6c63ff;
}
QLineEdit:focus {
    border-color: #6c63ff;
}

/* === QSpinBox / QDoubleSpinBox === */
QSpinBox, QDoubleSpinBox {
    background-color: #2a2a3c;
    color: #ffffff;
    border: 1px solid #3a3a4c;
    border-radius: 6px;
    padding: 6px 10px;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #6c63ff;
}

/* === QComboBox === */
QComboBox {
    background-color: #2a2a3c;
    color: #ffffff;
    border: 1px solid #3a3a4c;
    border-radius: 6px;
    padding: 6px 10px;
    min-width: 120px;
}
QComboBox:hover {
    border-color: #6c63ff;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #2a2a3c;
    color: #ffffff;
    selection-background-color: #6c63ff;
    border: 1px solid #3a3a4c;
}

/* === QTableWidget === */
QTableWidget {
    background-color: #2a2a3c;
    color: #ffffff;
    border: 1px solid #3a3a4c;
    gridline-color: #3a3a4c;
    border-radius: 6px;
}
QTableWidget::item {
    padding: 6px;
}
QTableWidget::item:selected {
    background-color: #6c63ff;
}
QHeaderView::section {
    background-color: #1e1e2e;
    color: #a0a0b0;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #3a3a4c;
    font-weight: bold;
}

/* === QProgressBar === */
QProgressBar {
    background-color: #2a2a3c;
    border: 1px solid #3a3a4c;
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
    min-height: 18px;
}
QProgressBar::chunk {
    border-radius: 3px;
}

/* Status-based progress bar colors */
QProgressBar[status="ok"]::chunk {
    background-color: #4CAF50;
}
QProgressBar[status="warning"]::chunk {
    background-color: #FFC107;
}
QProgressBar[status="danger"]::chunk {
    background-color: #F44336;
}

/* === QLabel === */
QLabel {
    color: #ffffff;
    background-color: transparent;
}
QLabel[class="title"] {
    font-size: 18px;
    font-weight: bold;
}
QLabel[class="subtitle"] {
    font-size: 14px;
    color: #a0a0b0;
}
QLabel[class="error"] {
    color: #F44336;
}

/* === QGroupBox === */
QGroupBox {
    background-color: #2a2a3c;
    border: 1px solid #3a3a4c;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 10px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #a0a0b0;
}

/* === QDateEdit === */
QDateEdit {
    background-color: #2a2a3c;
    color: #ffffff;
    border: 1px solid #3a3a4c;
    border-radius: 6px;
    padding: 6px 10px;
}
QDateEdit:focus {
    border-color: #6c63ff;
}

/* === Scrollbar === */
QScrollBar:vertical {
    background: #1e1e2e;
    width: 10px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #3a3a4c;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* === Sidebar specific === */
#sidebar {
    background-color: #16162a;
    border-right: 1px solid #2a2a3c;
}
